# Django production
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# PostgreSQL
POSTGRES_DB=avtoraqam
POSTGRES_USER=avtoraqam
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
USE_SQLITE=false

# Telegram
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_CHECK_INTERVAL_SECONDS=3600

# Резервный срок; индивидуальные сроки задаются в настройках CRM.
EXPIRY_WARNING_DAYS=14
